npts 40 48 40                        # num.grid points in xyz
gridfld protein_dry.maps.fld         # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N NA OA SA     # receptor atom types
ligand_types A C Cl NA OA N HD       # ligand atom types
receptor protein_dry.pdbqt           # macromolecule
gridcenter 18.5 6.823 4.04           # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map protein_dry.A.map                # atom-specific affinity map
map protein_dry.C.map                # atom-specific affinity map
map protein_dry.Cl.map               # atom-specific affinity map
map protein_dry.NA.map               # atom-specific affinity map
map protein_dry.OA.map               # atom-specific affinity map
map protein_dry.N.map                # atom-specific affinity map
map protein_dry.HD.map               # atom-specific affinity map
elecmap protein_dry.e.map            # electrostatic potential map
dsolvmap protein_dry.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
