@echo off
REM !/bin/csh
REM
REM Generated by CHARMM-GUI (http://www.charmm-gui.org)
REM This folder contains GROMACS formatted CHARMM36 force fields, a pre-optimized PDB structure, and GROMACS inputs.
REM All input files were optimized for GROMACS 2019.2 or above, so lower version of GROMACS can cause some errors.
REM We adopted the Verlet cut-off scheme for all minimization, equilibration, and production steps because it is 
REM faster and more accurate than the group scheme. If you have a trouble with a performance of Verlet scheme while 
REM running parallelized simulation, you should check if you are using appropriate command line.
REM For MPI parallelizing, we recommand following command:
REM mpirun -np $NUM_CPU %GMXPATH%\gmx.exe mdrun -ntomp 1
REM 
SETLOCAL
SET GMXPATH=\LOCATION\OF\GMX.EXE\
REM Minimization
REM step4.0
%GMXPATH%\gmx.exe grompp -f step4.0_minimization.mdp -o step4.0_minimization.tpr -c step3_charmm2gmx.pdb -r step3_charmm2gmx.pdb -p topol.top -maxwarn 1
%GMXPATH%\gmx.exe mdrun -v -deffnm step4.0_minimization
ECHO Potential | %GMXPATH%\gmx.exe energy -f step4.0_minimization.edr -o potential.xvg
REM NVT Equilibration
REM step4.1
%GMXPATH%\gmx.exe grompp -f step4.1_equilibration.mdp -o step4.1_equilibration.tpr -c step4.0_minimization.gro -r step3_charmm2gmx.pdb -n index.ndx -p topol.top
%GMXPATH%\gmx.exe mdrun -v -deffnm step4.1_equilibration
ECHO Temperature | %GMXPATH%\gmx.exe energy -f step4.1_equilibration.edr -o temperature.xvg
REM NPT equilibration
REM step4.2
%GMXPATH%\gmx.exe grompp -f step4.2_equilibration.mdp -o step4.2_equilibration.tpr -c step4.1_equilibration.gro -r step3_charmm2gmx.pdb -n index.ndx -p topol.top
%GMXPATH%\gmx.exe mdrun -v -deffnm step4.2_equilibration
ECHO Density | %GMXPATH%\gmx.exe energy -f step4.2_equilibration.edr -o density.xvg
REM Production
%GMXPATH%\gmx.exe grompp -f step5_production.mdp -o step5_md.tpr -c step4.2_equilibration.gro -n index.ndx -p topol.top
%GMXPATH%\gmx.exe mdrun -v -deffnm step5_md
REM Post-process trajectory for visualization
ECHO 1 0 | %GMXPATH%\gmx.exe trjconv -s step5_md.tpr -f step5_md.xtc -o step5_md_noPBC0.xtc -pbc mol -center -ur compact
ECHO 1 0 | %GMXPATH%\gmx.exe trjconv -s step5_md.tpr -f step5_md_noPBC0.xtc -o step5_md_noPBC.xtc -fit rot+trans
REM RMSD analysis
ECHO 4 4 | %GMXPATH%\gmx.exe rms -s step5_md.tpr -f step5_md_noPBC.xtc -o rmsd.xvg -tu ns
ECHO 4 4 | %GMXPATH%\gmx.exe rms -s step4.0_minimization.tpr -f step5_md_noPBC.xtc -o rmsd_xtal.xvg -tu ns
ECHO.
ECHO Your GROMACS job is finished!
PAUSE